    font-size: var(--text-sm, .94rem);
    font-weight: 600;
    color: var(--sl-color-text-invert);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 1rem;
    background: var(--sl-color-accent);
    border: 1px solid var(--sl-color-accent);
    border-radius: var(--radius-pill, 999px);
    box-shadow: 0 0 15px rgba(var(--sl-color-accent-rgb, 100, 150, 255), 0.3);
    transition: filter var(--duration-fast, 120ms), transform var(--duration-fast, 120ms);
  }
