  .entry-card-featured { border-color: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-hairline)); background: color-mix(in srgb, var(--sl-color-accent-low) 40%, var(--surface-card, var(--sl-color-bg-nav))); }
