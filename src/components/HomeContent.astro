---
// Trang chủ hướng người học: bắt đầu theo lộ trình, tra cứu kiến thức và luyện đề.
import { getCollection } from 'astro:content';
import { categories, domains as DOMAINS, levels as LEVELS } from '../config/taxonomy.js';
import { quizMeta } from '../config/quizzes.js';

const quizCount = Object.keys(quizMeta).length;

const all = await getCollection('docs');
const concepts = all.filter((d) => d.id.startsWith('concepts/'));
const totalConcepts = concepts.length;

// Domain mặc định mỗi category (dùng khi concept chưa có 'domains' — sẽ tự đầy dần khi rewrite)
const DEFAULT_DOMAINS = {
  '1-distributed-systems-architecture': ['DE'],
  '2-data-ingestion-integration': ['DE'],
  '3-storage-engines-formats': ['DE', 'Platform'],
  '4-compute-engines-batch': ['DE'],
  '5-stream-processing-realtime': ['DE'],
  '6-data-modeling-transformation': ['DE', 'DA'],
  '7-dataops-orchestration-quality': ['DE', 'Platform'],
  '8-security-governance-finops': ['Platform', 'DE'],
  '9-genai-machine-learning': ['DS'],
};

const domainVar = (d) => `var(--domain-${(d || 'de').toLowerCase()})`;

function shortTitle(t) {
  const m = (t || '').match(/\s[-–]\s+([a-zA-Z0-9\s]+)$/);
  return m && m[1] ? m[1].trim() : t;
}

const cards = categories.map((cat, i) => {
  const inCat = concepts.filter((d) => d.id.split('/')[1] === cat.slug);
  const domainSet = new Set();
  const levelSet = new Set();
  inCat.forEach((d) => {
    (d.data.domains || []).forEach((x) => domainSet.add(x));
    if (d.data.level) levelSet.add(d.data.level);
  });
  let domainList = [...domainSet];
  if (domainList.length === 0) domainList = DEFAULT_DOMAINS[cat.slug] || ['DE'];
  const links = inCat
    .slice()
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'vi'))
    .slice(0, 4)
    .map((d) => ({ label: shortTitle(d.data.title), href: `/${d.slug}/` }));
  return {
    number: i + 1,
    slug: cat.slug,
    title: cat.label.replace(/^\d+\.\s*/, ''),
    domains: domainList,
    levels: [...levelSet],
    count: inCat.length,
    color: domainVar(domainList[0]),
    links,
  };
});

// Mới cập nhật (theo lastUpdated) - Lấy 1 bài mới nhất từ mỗi chuyên mục
const targetFolders = [
  { prefix: 'quizzes/', label: 'Trắc nghiệm', fallbackDomain: 'DE' },
  { prefix: 'learning-paths/', label: 'Lộ trình', fallbackDomain: 'Platform' },
  { prefix: 'interview/', label: 'Phỏng vấn', fallbackDomain: 'DA' },
  { prefix: 'projects/', label: 'Dự án', fallbackDomain: 'DS' },
  { prefix: 'concepts/', label: 'Kiến thức', fallbackDomain: 'DE' }
];

const toTime = (v) => (v ? new Date(v).getTime() || 0 : 0);

const updated = targetFolders.map(folder => {
  const items = all.filter(d => d.id.startsWith(folder.prefix));
  if (items.length === 0) return null;
  items.sort((a, b) => toTime(b.data.lastUpdated) - toTime(a.data.lastUpdated));
  const top = items[0];
  
  let domain = folder.fallbackDomain;
  if (top.data.domains && top.data.domains.length > 0) {
    domain = top.data.domains[0];
  } else if (folder.prefix === 'concepts/') {
    const catSlug = top.id.split('/')[1];
    domain = (DEFAULT_DOMAINS[catSlug] || ['DE'])[0];
  }
  
  let title = shortTitle(top.data.title);
  if (folder.prefix === 'quizzes/' && top.slug === 'quizzes') title = 'Tổng hợp bộ đề thi Certificate';

  return {
    title: title,
    href: `/${top.slug}/`,
    date: top.data.lastUpdated ? new Date(top.data.lastUpdated).toISOString().slice(0, 10) : '',
    domain: folder.label,
    color: domainVar(domain),
  };
}).filter(Boolean);
---

<div class="home not-content">
  <main class="home-main">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="hero-copy">
        <p class="hero-kicker">SỔ TAY MỞ · DÀNH CHO NGƯỜI HỌC DATA</p>
        <h1 id="home-heading">Học kỹ thuật dữ liệu bằng tiếng Việt</h1>
        <p class="hero-description">Từ SQL, Python và hệ thống phân tán đến Spark, Kafka, lakehouse và data platform. Học theo lộ trình, hiểu qua ví dụ và tự kiểm tra bằng bộ đề thực hành.</p>
        <div class="hero-actions">
          <a class="hero-primary" href="/learning-paths/core-paths/beginner-de/">Bắt đầu học Data Engineering <span aria-hidden="true">→</span></a>
          <a class="hero-secondary" href="/quizzes/">Luyện đề chứng chỉ</a>
        </div>
        <p class="hero-stats"><span><strong>{totalConcepts}</strong> bài kiến thức</span><span><strong>{quizCount}</strong> bộ đề</span><span>Miễn phí · đọc mở</span></p>
      </div>
      <aside class="hero-roadmap" aria-label="Lộ trình học gợi ý">
        <span class="roadmap-label">LỘ TRÌNH GỢI Ý</span>
        <ol>
          <li><span>01</span><div><strong>Nắm nền tảng</strong><small>SQL · Python · Linux</small></div></li>
          <li><span>02</span><div><strong>Xử lý dữ liệu</strong><small>Batch · Spark · Kafka</small></div></li>
          <li><span>03</span><div><strong>Xây hệ thống</strong><small>Data lake · orchestration · quality</small></div></li>
        </ol>
        <a href="/learning-paths/overview/">Xem toàn bộ lộ trình <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <nav class="entry-grid" aria-label="Lối vào nội dung">
      <a class="entry-card" href="/concepts/"><span class="entry-icon" aria-hidden="true">⌘</span><span><strong>Tra cứu kiến thức</strong><small>Khái niệm và công nghệ dữ liệu</small></span><span class="entry-arrow" aria-hidden="true">↗</span></a>
      <a class="entry-card entry-card-featured" href="/quizzes/"><span class="entry-icon" aria-hidden="true">✓</span><span><strong>Luyện chứng chỉ</strong><small>AWS · Azure · Databricks · GCP</small></span><span class="entry-arrow" aria-hidden="true">↗</span></a>
      <a class="entry-card" href="/projects/"><span class="entry-icon" aria-hidden="true">▧</span><span><strong>Làm dự án thực tế</strong><small>Pipeline đầu cuối và system design</small></span><span class="entry-arrow" aria-hidden="true">↗</span></a>
      <a class="entry-card" href="/interview/overview/"><span class="entry-icon" aria-hidden="true">◎</span><span><strong>Ôn phỏng vấn</strong><small>SQL · Spark · thiết kế pipeline</small></span><span class="entry-arrow" aria-hidden="true">↗</span></a>
    </nav>

    <div class="toc-head">
      <div><p class="section-kicker">BẢN ĐỒ KIẾN THỨC</p><h2 class="serif-h">Chọn chủ đề để học</h2></div>
      <div class="toc-actions">
        <a href="/concepts/" class="toc-link">Tất cả bài viết →</a>
      </div>
    </div>

    <div class="topic-tools">
      <label for="category-search">Tìm chủ đề</label>
      <input id="category-search" type="search" placeholder="Ví dụ: Spark, Kafka, SQL…" autocomplete="off" aria-controls="cat-grid">
      <span id="category-count" aria-live="polite">{cards.length} nhóm kiến thức</span>
    </div>


    <div class="grid" id="cat-grid">
      {cards.map((c) => (
        <section class="cat" data-domains={c.domains.join(' ')} data-levels={c.levels.join(' ')} style={`--cat-color:${c.color};`}>
          <div class="cat-head">
            <span class="cat-num">{String(c.number).padStart(2, '0')}</span>
            <h3 class="cat-title"><a href={`/concepts/#${c.slug}`}>{c.title}</a></h3>
          </div>
          <div class="cat-links">
            {c.links.map((l) => <a class="ticker-item" href={l.href}>{l.label}</a>)}
            <a class="cat-all" href={`/concepts/#${c.slug}`}>Xem tất cả →</a>
          </div>
        </section>
      ))}
    </div>

    {updated.length > 0 && (
      <section class="updated">
        <div class="updated-intro">
          <h2 class="serif-h">Mới cập nhật</h2>
          <p>Sinh tự động từ lịch sử chỉnh sửa bài viết.</p>
        </div>
        <div class="updated-rows">
          {updated.map((u) => (
            <div class="u-row">
              <time>{u.date}</time>
              <a href={u.href}>{u.title}</a>
              <span class="u-domain" style={`color:${u.color};`}>{u.domain}</span>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>

  <div class="home-footer">
    <div class="band-inner footer-inner">
      <span>Sổ tay kỹ thuật dữ liệu — handbook mở cho cộng đồng Data/AI Việt Nam</span>
      <div class="footer-links">
        <a href="https://github.com/kythuatdulieu/kythuatdulieu.github.io">GitHub</a>
        <a href="https://github.com/kythuatdulieu/kythuatdulieu.github.io/issues">Đóng góp</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Trang chủ tự dàn trang toàn khổ: gỡ giới hạn và padding của khung Starlight */
  main:has(.home) .content-panel { padding: 0 !important; }
  main:has(.home) .sl-container { 
    max-width: none !important; 
    margin: 0 !important; 
    padding-bottom: 0 !important; 
  }
  .main-pane:has(.home) { padding-bottom: 0 !important; }
  /* Ẩn phần footer mặc định của Starlight (tạo ra khoảng trắng thừa) */
  .sl-container:has(.home) > footer { display: none !important; }
</style>

<style>
