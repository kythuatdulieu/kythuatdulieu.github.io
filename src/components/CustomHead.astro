---
import Default from '@astrojs/starlight/components/Head.astro';
import {
	DEFAULT_DESCRIPTION,
	ORGANIZATION_NAME,
	SITE_LOCALE,
	SITE_NAME,
	SITE_URL,
	toAbsoluteUrl,
	toIsoDate,
} from '../config/seo.js';

const { entry } = Astro.props;
const isDoc = Boolean(entry?.data);
const pageTitle = isDoc ? entry.data.title : SITE_NAME;
const pageDescription = isDoc ? entry.data.description || DEFAULT_DESCRIPTION : DEFAULT_DESCRIPTION;
const canonicalUrl = toAbsoluteUrl(Astro.url.pathname);
const modifiedDate = isDoc ? toIsoDate(entry.data.lastUpdated) : undefined;
const keywords = isDoc && Array.isArray(entry.data.tags) ? entry.data.tags.join(', ') : undefined;
const robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const publisher = {
	'@type': 'Organization',
	name: ORGANIZATION_NAME,
	url: SITE_URL,
	logo: {
		'@type': 'ImageObject',
		url: toAbsoluteUrl('/favicon.svg'),
	},
	sameAs: ['https://github.com/kythuatdulieu/kythuatdulieu.github.io'],
};

const schemaGraph = [
	{
		'@type': isDoc ? 'TechArticle' : 'WebSite',
		'@id': `${canonicalUrl}#${isDoc ? 'article' : 'website'}`,
		name: pageTitle,
		...(isDoc ? { headline: pageTitle } : {}),
		description: pageDescription,
		url: canonicalUrl,
		inLanguage: 'vi-VN',
		publisher,
		...(isDoc
			? {
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
				author: { '@type': 'Organization', name: ORGANIZATION_NAME, url: SITE_URL },
				...(modifiedDate ? { dateModified: modifiedDate } : {}),
				...(keywords ? { keywords } : {}),
				...(Array.isArray(entry.data.domains) && entry.data.domains.length
					? { articleSection: entry.data.domains.join(', ') }
					: {}),
			}
			: {}),
	},
];

if (isDoc) {
	schemaGraph.push({
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Trang chủ', item: toAbsoluteUrl('/') },
			{ '@type': 'ListItem', position: 2, name: pageTitle, item: canonicalUrl },
		],
	});
}

const schema = {
	'@context': 'https://schema.org',
	'@graph': schemaGraph,
};
---

<Default {...Astro.props} />

<link rel="alternate" hreflang="vi" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#0f172a" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:type" content={isDoc ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{isDoc && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{isDoc && Array.isArray(entry.data.domains) && entry.data.domains[0] && (
	<meta property="article:section" content={entry.data.domains[0]} />
)}
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

<script is:inline>
	// Pre-paint: áp lựa chọn đọc từ localStorage trước khi render để không nháy màn hình.
	(function () {
		try {
			var d = document.documentElement;
			var theme = localStorage.getItem('dehb-theme') || localStorage.getItem('starlight-theme');
			if (theme === 'auto' || !theme) {
				theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			d.setAttribute('data-theme', theme);
			d.setAttribute('data-measure', localStorage.getItem('dehb-measure') || 'medium');
			d.setAttribute('data-font', localStorage.getItem('dehb-font') || 'sans');
			var scale = localStorage.getItem('dehb-font-scale');
			if (scale) d.style.setProperty('--reading-font-scale', scale);
		} catch (e) {}
	})();
</script>
